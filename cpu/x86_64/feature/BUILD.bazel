# Constraints describing individual x86-64 CPU features.
#
# For each feature, this package defines:
#
#   * a `<feature>_setting` constraint setting,
#   * `<feature>_available` and `<feature>_unavailable` constraint values for `platform`s and
#     `exec_compatible_with` / `target_compatible_with`, and
#   * `<feature>` and `no_<feature>` config settings to use as `select()` keys, e.g.
#     `@platforms_contrib//cpu/x86_64/feature:avx`.
#
# Baseline features default to available; all others default to unavailable.

load(
    "//cpu/x86_64:x86_64_private.bzl",
    "X86_64_EXTRA_FEATURES",
    "X86_64_FEATURES",
    "X86_64_FEATURE_REFINEMENTS",
    "X86_64_LLVM_FEATURES",
)
load(":feature.bzl", "x86_64_feature")

[
    x86_64_feature(
        name = feature,
        available_by_default = feature in X86_64_FEATURES["v1"],
        refines = X86_64_FEATURE_REFINEMENTS.get(feature),
    )
    for feature in X86_64_LLVM_FEATURES + X86_64_EXTRA_FEATURES
]
